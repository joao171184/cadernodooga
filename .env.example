# Copie para .env (local) e configure os mesmos nomes na Vercel/Lovable.
# Nunca coloque valores reais neste arquivo.

# ---------- Frontend (vão para o bundle: só valores PÚBLICOS) ----------
VITE_SUPABASE_PROJECT_ID="seu-project-id"
VITE_SUPABASE_URL="https://seu-project-id.supabase.co"
# Chave publishable/anon do Supabase (pública por design; a segurança vem do RLS)
VITE_SUPABASE_PUBLISHABLE_KEY="sua-chave-anon-publica"
# URL pública oficial do site, usada nos links de autenticação
VITE_PUBLIC_SITE_URL="https://cadernodooga.com.br"

# ---------- Edge Functions (secrets do Supabase; NUNCA com prefixo VITE_) ----------
# Configure com: supabase secrets set NOME=valor  (ou no painel de secrets do Lovable/Supabase)
# Chave da API do Brevo (Transactional > SMTP & API > API Keys)
BREVO_API_KEY=
# Remetente verificado no Brevo
BREVO_SENDER_EMAIL="nao-responda@seu-dominio.com.br"
BREVO_SENDER_NAME="Caderno do Ogã"
# URL pública usada para montar os links dos e-mails (https)
PUBLIC_SITE_URL="https://cadernodooga.com.br"
# Segredo gerado pelo Supabase ao ativar o Send Email Hook (formato v1,whsec_...)
SEND_EMAIL_HOOK_SECRET=
# Origens autorizadas a chamar admin-delete-user (separadas por vírgula)
ALLOWED_ORIGINS="https://cadernodooga.com.br,https://www.cadernodooga.com.br"
